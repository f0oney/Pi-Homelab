# Pi-Hole Proxy
server {
    listen 80;
    listen [::]:80;

    server_name your.domain.com www.your.domain.com;
    return 301 https://your.domain.com;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name your.domain.com www.your.domain.com;
    
    ssl_certificate /ssl/location/path;
    ssl_certificate_key /ssl/location/path;

   location / {
       proxy_pass http://YOUR_IP_ADDRESS:PORT;
       proxy_set_header Host $host;
       proxy_set_header X-Real-IP $remote_addr;
       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
       proxy_set_header X-Forwarded-Proto $scheme;
   }
}

# Vault Warden Proxy
server {
    listen 80; # http port
    listen [::]:80; # used for ipv6

    server_name your.domain.com www.your.domain.com;
    return 301 https://your.domain.com;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name your.domain.com www.your.domain.com;

    ssl_certificate /ssl/location/path;
    ssl_certificate_key /ssl/location/path;

   location / {

       proxy_pass http://YOUR_IP_ADDRESS:PORT;
       proxy_set_header Host $host;
       proxy_set_header X-Real-IP $remote_addr;
       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
       proxy_set_header X-Forwarded-Proto $scheme;
   }
}

# Proxmox Proxy

server {
    listen 80; # http port
    listen [::]:80; # used for ipv6

    server_name your.domain.com www.your.domain.com;
    return 301 https://your.domain.com;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name your.domain.com www.your.domain.com;

    ssl_certificate /ssl/location/path;
    ssl_certificate_key /ssl/location/path;

   location / {

       proxy_pass https://YOUR_IP_ADDRESS;
       proxy_http_version 1.1;
       proxy_set_header Upgrade $http_upgrade;
       proxy_set_header Connection "upgrade";

       proxy_set_header Host $host;
       proxy_set_header X-Real-IP $remote_addr;
       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
       proxy_set_header X-Forwarded-Proto $scheme;

       proxy_buffering off;
       client_max_body_size 0;
   }
}

